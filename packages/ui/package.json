    "@primeuix/themes": {
      "optional": true
    },
    "primevue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@primeuix/themes": "^1.2.3",
    "@vue/tsconfig": "^0.7.0",
    "primevue": "^4.3.7",
    "typescript": "~5.8.3",
    "vue": "^3.5.18",
    "vue-tsc": "^3.0.5"
