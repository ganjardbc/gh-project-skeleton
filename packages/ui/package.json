{
  "name": "@gh-skeleton/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./prime": "./src/prime/index.ts",
    "./theme-script": "./src/composables/themeScript.ts",
